# The frontend must be reachable by the Nginx Proxy Manager container.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3200

# Local image names used by the production Compose build.
WEB_IMAGE=oasfuse-web:local
API_IMAGE=oasfuse-api:local

# Used only when running Next.js outside Docker. Compose overrides this value.
# Never expose it with NEXT_PUBLIC_*.
INTERNAL_API_URL=http://localhost:8080

